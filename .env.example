# Copy to .env.local (gitignored). Test values for a local Switch server only.
SWITCH_URL=http://localhost:PORT          # Switch server base URL (from Switch Console)
SWITCH_REGISTRATION_KEY=                  # Gateway -> API Keys; used by `just setup` only
COUNTERSIGN_KEY_FILE=~/.config/countersign/countersign.key   # agent API key file, chmod 600
COUNTERSIGN_AGENT_ID=                     # written by register_agents
SCRIPTED_INTAKE_KEY_FILE=~/.config/countersign/scripted-intake.key
ROGUE_KEY_FILE=~/.config/countersign/rogue.key
MM_URL=http://localhost:8065              # Mattermost bundled with Switch
MM_ADMIN_USER=                            # Console "Sign-in details..."; setup scripts only
MM_ADMIN_PASSWORD=
MM_TEAM=                                  # team the template's channels live in
PERSONA_PASSWORD_FILE=~/.config/countersign/personas.json    # generated test passwords
ROOM_INTAKE=ap-intake
ROOM_APPROVALS=ap-approvals
ROOM_AUDIT=ap-audit
COUNTERSIGN_DB=var/countersign.db
COUNTERSIGN_MODE=ws                       # ws or poll
LOG_LEVEL=INFO
